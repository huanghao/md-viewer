{
  "name": "md-viewer",
  "version": "0.5.0",
  "description": "Markdown viewer with live reload",
  "type": "module",
  "engines": {
    "bun": ">=1.2.5"
  },
  "bin": {
    "mdv": "./src/cli.ts"
  },
  "scripts": {
    "build:client": "bun run build.ts",
    "build:client:watch": "bun run build.ts --watch",
    "build:scanner": "mkdir -p .cache && go build -o .cache/mdv-workspace-scanner ./cmd/workspace-scanner",
    "dev": "bun --watch run src/server.ts",
    "build": "rm -rf dist/static && bun run build:scanner && bun run build:client && mkdir -p dist/static && cp public/index.html dist/client.js dist/client.css dist/annotation-marks.css dist/static/ && bun build src/cli.ts --compile --outfile=dist/mdv",
    "cli": "bun run src/cli.ts",
    "test": "bun test tests/unit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "chokidar": "^5.0.0",
    "hono": "^3.12.8",
    "minimatch": "^10.2.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-fetch": "^0.222.0",
    "@opentelemetry/sdk-trace-web": "^2.11.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.3.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.27.3",
    "happy-dom": "14",
    "pdfjs-dist": "^5.6.205",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
